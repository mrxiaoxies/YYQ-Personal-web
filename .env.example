# 浏览器公开配置：Netlify 同域运行和当前 GitHub Pages 地址均可留空；其他跨域前端填写后端站点地址。
VITE_KNOWLEDGE_API_BASE=

# 仅用于显式关闭助手；默认无需设置。
VITE_KNOWLEDGE_API_ENABLED=true

# 以下变量只供 Netlify Function 服务端读取，绝不能改成 VITE_ 前缀。
# Netlify AI Gateway 在受支持的运行环境中会自动注入这一对专用变量，通常保持空白即可。
# 应用会优先读取这对变量；如果手动填写，KEY 与 BASE_URL 必须同时存在。
# NETLIFY_AI_GATEWAY_KEY=
# NETLIFY_AI_GATEWAY_BASE_URL=

# OpenAI 兼容服务端变量仅作为后备，也必须成对配置；不要只填写其中一个。
# 不使用自带凭据时保持空白，让 Netlify 自动管理 Gateway 凭据。
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# 可选服务端配置：回答模型、额外允许的完整网页源、本地模型根目录。
KNOWLEDGE_MODEL=gpt-5.4-mini
KNOWLEDGE_ALLOWED_ORIGINS=
RAG_EMBEDDING_MODEL_ROOT=
