# 浏览器公开配置：Netlify 同域运行和当前 GitHub Pages 地址均可留空；其他跨域前端填写后端站点地址。
VITE_KNOWLEDGE_API_BASE=

# 仅用于显式关闭助手；默认无需设置。
VITE_KNOWLEDGE_API_ENABLED=true

# 管理界面与动态站点内容的非生产示例。请在 Netlify 中替换为实际配置，不要直接沿用示例值。
# ADMIN_SETUP_TOKEN 和 ADMIN_RECOVERY_TOKEN 只供服务端读取，绝不能使用 VITE_ 前缀。
ADMIN_SETUP_TOKEN=replace-with-at-least-32-random-characters
ADMIN_RECOVERY_TOKEN=replace-with-a-new-at-least-32-character-token
ADMIN_ALLOWED_ORIGINS=http://localhost:8888,http://127.0.0.1:8888
PUBLIC_SITE_ALLOWED_ORIGINS=https://mrxiaoxies.github.io
VITE_ADMIN_SITE_URL=https://yyq-web.netlify.app/#admin
VITE_SITE_CONTENT_API_BASE=https://yyq-web.netlify.app

# 以下变量只供 Netlify Function 服务端读取，绝不能改成 VITE_ 前缀。
# Netlify AI Gateway 在受支持的运行环境中会自动注入这一对专用变量，通常保持空白即可。
# 应用会优先读取这对变量；如果手动填写，KEY 与 BASE_URL 必须同时存在。
# NETLIFY_AI_GATEWAY_KEY=
# NETLIFY_AI_GATEWAY_BASE_URL=

# OpenAI 兼容服务端变量仅作为后备，也必须成对配置；不要只填写其中一个。
# 不使用自带凭据时保持空白，让 Netlify 自动管理 Gateway 凭据。
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# 可选服务端配置：回答模型、额外允许的完整网页源、本地模型根目录。
KNOWLEDGE_MODEL=gpt-5.4-mini
KNOWLEDGE_ALLOWED_ORIGINS=
RAG_EMBEDDING_MODEL_ROOT=
